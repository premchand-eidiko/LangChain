# Required for AI responses
GROQ_API_KEY=

# Optional: Tavily web search
SEARCH_API_KEY=

# Optional: Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

# Database (leave empty for local SQLite at data/production_ai_agent.db)
DATABASE_URL=

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth (change JWT_SECRET before production)
JWT_SECRET=
JWT_ALGORITHM=HS256

# LLM settings
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Upload storage (leave empty for data/uploads)
UPLOAD_DIR=
